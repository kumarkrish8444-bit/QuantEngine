PORT=3000
NODE_ENV=development
# Optional: CoinGecko Demo API key (crypto aggregation fallback)
COINGECKO_DEMO_API_KEY=
# Optional: Alpha Vantage key for supported stock/FX data; free plan is limited
ALPHA_VANTAGE_API_KEY=
# Optional: set to true only when you intentionally enable authenticated trading later
ENABLE_TRADING=false
